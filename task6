#include <iostream>
using namespace std;

int main() {
    double V[] = {50, 80, 100, 120, 150};       // скорости
    double rho[] = {1.225, 1.1, 0.95, 0.8, 0.65}; // плотности
    int n = 5;
    double S = 20, CL = 0.5; // площадь крыла и коэффициент одинаковые

    cout << "| Шаг | Скорость | Плотность | Подъемная сила |" << endl;
    for (int i = 0; i < n; i++) {
        double L = 0.5 * rho[i] * V[i] * V[i] * S * CL;
        cout << "|  " << i << "  |    " << V[i]
             << "    |    " << rho[i]
             << "     |     " << L << "     |" << endl;
    }
    return 0;
}
