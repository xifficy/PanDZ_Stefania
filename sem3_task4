#include <iostream>
#include <vector>
#include <numeric>
#include <iomanip>
using namespace std;

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    vector<double> velocities;
    for (double t = 0.0; ; t += dt) {
        double v = v0 - g * t;
        if (v < -v0) break;   
        velocities.push_back(v);
    }
   
    if (velocities.empty()) {
        cout << "нет данных" << endl;
        return 0;
    }

    double sum = accumulate(velocities.begin(), velocities.end(), 0.0);
    double avg = sum / velocities.size();

    cout << "средняя скорость полета" << fixed << setprecision(2)
         << avg << " м/с" << endl;
    return 0;
}