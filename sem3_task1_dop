// Максимальная высота(через max_element)

#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    vector<double> heights;
    for (double t = 0.0; ; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) break;
        heights.push_back(h);
    }

    auto it = max_element(heights.begin(), heights.end());
    size_t idx = distance(heights.begin(), it);
    cout << "максимальная высота: " << *it
         << " м, момент времени t = " << idx * dt << " с" << endl;
    return 0;
}
