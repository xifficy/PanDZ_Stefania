#include <iostream> 
#include <cmath> 
using namespace std;
int main() { 
double m, S, CL, h; 
double Tmin, Tmax, dT; 
double V = 100, rho = 1.225; 
double g = 9.81;
cout << "Введите m, S, CL: ";
cin >> m >> S >> CL;
cout << "Введите высоту h: ";
cin >> h;
cout << "Введите Tmin, Tmax, шаг dT: ";
cin >> Tmin >> Tmax >> dT;

double L = 0.5 * rho * V * V * S * CL; // подъемная сила одна для всех

double bestT = 0, bestTime = 0;

for (double T = Tmin; T <= Tmax; T += dT) {
    double ay = (L + T - m * g) / m; // считаем, что тяга помогает набору

    if (ay <= 0) {
        cout << "T = " << T << ": не набирает высоту" << endl;
        continue;
    }

    double t = sqrt(2 * h / ay);
    cout << "T = " << T << "  ay = " << ay << "  t = " << t << " с" << endl;

    if (bestTime == 0 || t < bestTime) {
        bestTime = t;
        bestT = T;
    }
}

cout << "Оптимальная тяга T = " << bestT
     << ", время набора высоты = " << bestTime << " с" << endl;
return 0;
}
