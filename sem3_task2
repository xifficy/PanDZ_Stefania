// Максимальная высота плюс проверка при плато(одинаковых значениях)


#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    vector<double> times, heights;
    for (double t = 0.0; ; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) break;
        times.push_back(t);
        heights.push_back(h);
    }

    if (heights.empty()) {
        cout << "нет данных" << endl;
        return 0;
    }
    auto it = max_element(heights.begin(), heights.end());
    size_t idx = distance(heights.begin(), it);
    cout << "(проверка через STL) h_max = " << *it
         << ", t = " << times[idx] << endl;


