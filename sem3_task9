#include <iostream>
#include <vector>
#include <iomanip>
using namespace std;

int main() {
    // высота с шумом
    vector<double> h = {0, 49, 92, 120, 131, 123, 95, 51, 8, -40};
    size_t n = h.size();

    vector<double> smoothed(n);
    smoothed[0] = h[0];           // границы оставляем как есть
    smoothed[n - 1] = h[n - 1];
    for (size_t i = 1; i + 1 < n; ++i) {
        smoothed[i] = (h[i - 1] + h[i] + h[i + 1]) / 3.0;  // среднее из трех
    }

    cout << setw(12) << "исходный" << setw(12) << "сглаженный" << endl;
    for (size_t i = 0; i < n; ++i) {
        cout << setw(12) << fixed << setprecision(2) << h[i]
             << setw(12) << smoothed[i] << endl;
    }
    return 0;
}
